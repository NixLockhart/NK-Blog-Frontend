# ================================
# 博客前端 - 默认环境配置
# ================================
#
# 说明：
# 1. 此文件是默认配置，会被 .env.development 或 .env.production 覆盖
# 2. 所有配置项都应以 VITE_ 开头才能在前端代码中访问
# 3. 修改后需要重启开发服务器才能生效
#

# API 路径前缀
# 所有 API 请求都会添加此前缀
# 例如：/api/articles, /api/config
VITE_API_BASE_URL=/api

# 网站标题
# 显示在浏览器标签页和页面标题中
VITE_APP_TITLE=星光小栈
