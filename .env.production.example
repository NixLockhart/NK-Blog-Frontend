# Production Environment Example
# 生产环境配置示例

# API基础路径（相对路径）
VITE_API_BASE_URL=/api

# 后端服务器基础URL配置
# 场景1：前后端部署在同一服务器、同一域名下（如通过Nginx反向代理）
#        这种情况使用空值即可，所有资源通过相对路径访问
VITE_BASE_URL=

# 场景2：后端单独部署在不同的域名或端口
#        需要配置完整的后端服务器地址
#        示例：
#        VITE_BASE_URL=http://api.example.com
#        VITE_BASE_URL=http://example.com:8080
#        VITE_BASE_URL=https://api.example.com

# 网站标题
VITE_APP_TITLE=星光小栈
